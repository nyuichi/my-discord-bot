[Unit]
Description=Personal Discord Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/my-discord-bot
Environment=NODE_ENV=production
Environment=STATE_FILE=%h/apps/my-discord-bot/data/state.json
Environment=OPENAI_REASONING_EFFORT=medium
ExecStart=%h/.local/bin/node dist/src/index.js
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
