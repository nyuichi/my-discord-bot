# Secrets (never commit the real values)
DISCORD_TOKEN=
OPENAI_API_KEY=

# OpenAI: gpt-5.6 currently routes to the flagship gpt-5.6-sol model.
OPENAI_MODEL=gpt-5.6
OPENAI_REASONING_EFFORT=medium
MAX_OUTPUT_TOKENS=2000

# Context and channel memory
HISTORY_MESSAGE_LIMIT=30
HISTORY_MAX_CHARS=12000
SUMMARY_EVERY_MENTIONS=8
SUMMARY_MAX_TOKENS=600

# Cost guard. Prices are configurable because API pricing can change.
MONTHLY_BUDGET_USD=20
MAX_DAILY_API_CALLS=80
PRICE_INPUT_PER_MILLION_USD=5
PRICE_CACHED_INPUT_PER_MILLION_USD=0.5
PRICE_CACHE_WRITE_PER_MILLION_USD=6.25
PRICE_OUTPUT_PER_MILLION_USD=30
CHANNEL_COOLDOWN_SECONDS=5

# Optional comma-separated allowlist. Empty means all channels visible to the bot.
ALLOWED_CHANNEL_IDS=

# Persistent state contains summaries and aggregate usage, never raw transcripts.
STATE_FILE=/app/data/state.json
LOG_LEVEL=info
