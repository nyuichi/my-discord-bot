{
  "name": "demachi-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mention-only Discord colleague bot powered by the OpenAI Responses API.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/test/**/*.test.js",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "discord.js": "^14.0.0",
    "dotenv": "^17.0.0",
    "openai": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
